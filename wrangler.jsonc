{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "werewolf-league",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LEAGUE", "class_name": "LeagueDO" },
      { "name": "MATCH", "class_name": "MatchDO" },
      { "name": "PLAYER", "class_name": "PlayerDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LeagueDO", "MatchDO", "PlayerDO"] }
  ],
  "vars": {
    // How often a Player DO polls its Harness for a finished turn.
    "PLAYER_POLL_MS": "1000",
    // Managed-agent watchdog: cancel a turn still running after this long (0 = off).
    // Turn deadlines proper live in the Player DO; this only stops a stuck interaction.
    "MANAGED_AGENT_MAX_TURN_MS": "120000"
  },
  "observability": { "enabled": true }
}
