{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "werewolf-league",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The pi harness (agents, pi-ai) needs Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  // Agent Instructions (docs/agent-instructions/*.md) are bundled as text modules.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LEAGUE", "class_name": "LeagueDO" },
      { "name": "MATCH", "class_name": "MatchDO" },
      { "name": "PLAYER", "class_name": "PlayerDO" },
      // Hosts Pi Durable for one pi seat (ADR-0003).
      { "name": "PI_SEAT", "class_name": "PiSeatDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LeagueDO", "MatchDO", "PlayerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PiSeatDO"] }
  ],
  "vars": {
    // How often a Player DO polls its Harness for a finished turn.
    "PLAYER_POLL_MS": "1000",
    // Retry interval for League Match starts and Match result delivery.
    "LEAGUE_RETRY_MS": "2000"
  },
  "observability": { "enabled": true }
}
